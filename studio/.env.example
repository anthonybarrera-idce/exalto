# Firebase web app config: the same values as admin/.env.local
# (Firebase console → Project settings → Your apps → Web app). 
VITE_FIREBASE_API_KEY=your-firebase-value
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-value
VITE_FIREBASE_PROJECT_ID=your-firebase-value
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-value
VITE_FIREBASE_APP_ID=your-firebase-value

# Google sign-in for the desktop app: Google Cloud console → APIs & Services → Credentials →
# Create credentials → OAuth client ID → Application type "Desktop app" (same project as Firebase).
MAIN_VITE_GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
MAIN_VITE_GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# Set to true to use the local Firebase emulators (cd admin && npm run emulators).
VITE_USE_EMULATORS=false
