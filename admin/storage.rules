rules_version = '2';

// Hymn files uploaded by Hymn Studio: piano audio, voice practice tracks, the MusicXML score and
// practice.json (the notes the mobile app's practice screen draws and plays).
// Admin roles live in the Firebase Auth custom claim `role` (same as firestore.rules).
service firebase.storage {
  match /b/{bucket}/o {
    function canEditContent() {
      return request.auth != null && request.auth.token.role in ['owner', 'admin', 'editor'];
    }
    // Composers write only the files of hymns they own (Studio creates the hymn doc before uploading).
    function ownsHymn(hymnId) {
      return request.auth != null && request.auth.token.get('composer', false) == true
        && firestore.get(/databases/(default)/documents/hymns/$(hymnId)).data.get('ownerUid', null) == request.auth.uid;
    }

    match /hymns/{hymnId}/{allPaths=**} {
      // The app streams these by download URL; listing and reading by path are open too.
      allow read: if true;
      allow write: if (canEditContent() || ownsHymn(hymnId))
        && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*')
            || request.resource.contentType == 'application/vnd.recordare.musicxml+xml');
      allow delete: if canEditContent() || ownsHymn(hymnId);
    }

    // JSON is allowed for this one file only (read is covered by the rule above).
    match /hymns/{hymnId}/practice.json {
      allow write: if (canEditContent() || ownsHymn(hymnId))
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }

    // A composer manages the cover of a hymnal they own (`ownerUid`, set when they created it).
    function ownsHymnal(hymnalId) {
      return request.auth != null && request.auth.token.get('composer', false) == true
        && firestore.get(/databases/(default)/documents/hymnals/$(hymnalId)).data.get('ownerUid', null) == request.auth.uid;
    }

    // Hymnal thumbnail (admin Hymnals page, or the mobile app's hymnal editor): one square image per hymnal, shown
    // on all its hymns in the app. Both clients shrink it to 512 px before upload (~100 KB), so 1 MB is a hard cap.
    match /hymnals/{hymnalId}/{file} {
      allow read: if true;
      allow write: if (canEditContent() || ownsHymnal(hymnalId))
        && file.matches('thumbnail[.](jpg|png|webp)')
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if canEditContent() || ownsHymnal(hymnalId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
