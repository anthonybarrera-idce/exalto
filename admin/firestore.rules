rules_version = '2';

// Admin roles live in the Firebase Auth custom claim `role` (set with scripts/set-role.mjs).
service cloud.firestore {
  match /databases/{database}/documents {
    function role() { return request.auth != null ? request.auth.token.role : null; }
    // owner > admin > editor / moderator. Only the church account is ever owner (enforced in Cloud Functions).
    function isAdmin() { return role() in ['owner', 'admin', 'editor', 'moderator']; }
    function canEditContent() { return role() in ['owner', 'admin', 'editor']; }
    function canManageTeam() { return role() in ['owner', 'admin']; }
    // Composers (auth claim `composer`, set by setUserRole/inviteMember) create their own hymnals and
    // upload and manage only their own hymns, marked with `ownerUid`.
    function isComposer() { return request.auth != null && request.auth.token.get('composer', false) == true; }
    function ownsHymnal(id) {
      return isComposer() && exists(/databases/$(database)/documents/hymnals/$(id))
        && get(/databases/$(database)/documents/hymnals/$(id)).data.get('ownerUid', null) == request.auth.uid;
    }

    // Hymn Studio (desktop) access list, keyed by lower-case Google email. Owners manage it in the
    // admin; a person may read only their own entry (that's how Studio checks it at sign-in).
    match /studioAccess/{email} {
      allow read: if isAdmin() || (request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email);
      allow create: if canManageTeam()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'note', 'addedBy', 'addedByName', 'addedAt'])
        && request.resource.data.email == email
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time;
      allow update: if false;
      allow delete: if canManageTeam();
    }

    // Team invites by Google email, written only by the inviteMember / revokeInvite / acceptInvite functions.
    match /members/{email} {
      allow read: if canManageTeam();
      allow write: if false;
    }

    // Hymnals shown in the app's hymnal picker. Anyone can read them (the app needs them before sign-in);
    // owners, admins and editors edit them; only owners and admins delete one. Built-in hymnals
    // (idc-himnario, canticos-espirituales, community) also exist in code as defaults, so a missing doc is fine.
    // Composers create community hymnals they own (`ownerUid`), edit and delete only those, and can't make
    // them download for offline use on every phone.
    match /hymnals/{hymnalId} {
      function validHymnal() {
        return hymnalId.matches('[a-z0-9-]{2,40}')
          && request.resource.data.keys().hasOnly(['name', 'shortName', 'color', 'kind', 'visible', 'offline', 'order', 'ownerUid', 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'updatedBy'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && request.resource.data.kind in ['official', 'community']
          && request.resource.data.visible is bool
          && request.resource.data.offline is bool
          && request.resource.data.order is int && request.resource.data.order >= 0
          && request.resource.data.updatedBy == request.auth.uid
          && (!('createdByName' in request.resource.data) || (request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 80));
      }
      function composerHymnal() {
        // The built-in hymnals may have no doc yet; a composer must never be able to claim one.
        return isComposer()
          && !(hymnalId in ['idc-himnario', 'canticos-espirituales', 'community'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.kind == 'community'
          && request.resource.data.offline == false;
      }
      allow read: if true;
      // `createdBy` / `createdByName` (shown under the hymnal in the app) can only name the person creating it.
      allow create: if validHymnal() && (canEditContent() || composerHymnal())
        && (!('createdBy' in request.resource.data) || request.resource.data.createdBy == request.auth.uid);
      allow update: if validHymnal() && (canEditContent()
        || (composerHymnal() && resource.data.get('ownerUid', null) == request.auth.uid));
      allow delete: if canManageTeam() || (isComposer() && resource.data.get('ownerUid', null) == request.auth.uid);
    }

    match /hymns/{hymnId} {
      function ownsHymn() { return isComposer() && resource.data.get('ownerUid', null) == request.auth.uid; }
      // Composers write only their own hymns, only into hymnals they own, and can't hand a hymn to someone else.
      function composerWrite() {
        return request.resource.data.ownerUid == request.auth.uid && ownsHymnal(request.resource.data.hymnalId);
      }
      // The mobile app reads published hymns; admins read everything; composers read their own. A missing doc can
      // be checked by anyone signed in (Studio looks before its first upload).
      allow read: if resource == null && request.auth != null
        || resource.data.status == 'published' || isAdmin() || ownsHymn();
      allow create: if canEditContent() || composerWrite();
      allow update: if canEditContent() || (ownsHymn() && composerWrite());
      allow delete: if canEditContent() || ownsHymn();
    }

    match /auditLog/{entryId} {
      allow read: if isAdmin();
      // Append-only, and entries must be attributed to the signed-in admin.
      allow create: if (isAdmin() || isComposer()) && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // People manage their own profile but can't set role or moderation status.
      allow create: if request.auth != null && request.auth.uid == uid
        && !('role' in request.resource.data) && !('status' in request.resource.data);
      allow update: if request.auth != null && (
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'statusUpdatedAt', 'statusUpdatedBy']))
        // Admins may change moderation status only; role is set by the setUserRole Cloud Function.
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt', 'statusUpdatedBy'])
          && request.resource.data.status in ['active', 'warned', 'suspended'])
      );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
